{
    "name": "docs",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsx ./scripts/fetch-github-stats.ts && vite build",
        "build:indexnow": "tsx ./scripts/fetch-github-stats.ts && vite build --mode indexnow",
        "cf-typegen": "wrangler types && mv worker-configuration.d.ts src/",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "deploy": "npm run build:indexnow && wrangler deploy",
        "dev": "vite dev",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "lint:fix": "npm run format && eslint . --fix",
        "preview": "vite preview",
        "test": "npm run test:unit -- --run && npm run test:e2e",
        "test:e2e": "playwright test",
        "test:unit": "vitest"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@humanspeak/docs-kit": "github:humanspeak/docs-kit#2026.7.28",
        "@humanspeak/svelte-headless-table": "workspace:*",
        "@humanspeak/svelte-markdown": "^1.8.5",
        "@humanspeak/svelte-motion": "^0.8.2",
        "github-slugger": "^2.0.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260801.1",
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.5.0",
        "@internationalized/date": "^3.12.3",
        "@lucide/svelte": "^1.28.0",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/table-core": "^9.0.0",
        "@typescript-eslint/eslint-plugin": "^8.66.0",
        "@typescript-eslint/parser": "^8.66.0",
        "autoprefixer": "^10.5.4",
        "bits-ui": "^2.18.1",
        "chokidar-cli": "^3.0.0",
        "clsx": "^2.1.1",
        "embla-carousel-svelte": "^8.6.0",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-svelte": "3.22.0",
        "eslint-plugin-unused-imports": "4.4.1",
        "formsnap": "^2.0.1",
        "globals": "^17.9.0",
        "mdsvex": "^0.12.8",
        "mode-watcher": "^1.1.0",
        "paneforge": "^1.0.2",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "shiki": "^4.4.1",
        "svelte": "^5.56.8",
        "svelte-check": "^4.7.4",
        "svelte-sonner": "^1.1.1",
        "sveltekit-superforms": "^2.30.2",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "tsx": "^4.23.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.66.0",
        "vaul-svelte": "1.0.0-next.7",
        "vite": "^8.2.0",
        "vitest": "^4.1.10",
        "wrangler": "^4.118.0",
        "zod": "^4.4.3"
    },
    "volta": {
        "node": "24.15.0"
    }
}
